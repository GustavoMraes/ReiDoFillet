# Conexão com o PostgreSQL (Neon.tech em produção). Nunca versionar o .env real.
# Na string do Neon: troque "postgresql://" por "postgresql+asyncpg://" e
# "?sslmode=require&channel_binding=require" por "?ssl=require".
DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/reidofilet

# Origens permitidas pelo CORS, separadas por vírgula (domínio da Vercel em produção)
CORS_ORIGINS=http://localhost:5173

# Chave de assinatura dos tokens de sessão (obrigatória, mínimo de 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar a chave encerra todas as sessões abertas.
JWT_SECRET=
# Validade da sessão, em horas
JWT_EXPIRACAO_HORAS=12

# Fuso usado para exibir datas
TZ_EXIBICAO=America/Sao_Paulo

# Banco usado pelos testes de integração (recriado a cada execução). Sem ele, esses testes são pulados.
TEST_DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/reidofilet_test
